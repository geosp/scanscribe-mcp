# Copy to .env (which Git ignores) and fill in. The server reads .env at start-up; real
# environment variables and command-line options take precedence. All variables and their
# defaults are listed in the README.

# --- HTTP server -------------------------------------------------------------------------------
MCP_TRANSPORT=http
MCP_PORT=8302

# The bearer token clients send to /mcp. Generate one with:  openssl rand -hex 32
# Without it the HTTP server refuses to start (unless --no-auth). Never commit the real value.
SCANSCRIBE_MCP_TOKEN=

# Base of upload links and download URLs: the address clients use to reach this server.
# Set it behind a reverse proxy, or when clients reach the server by another host name.
SCANSCRIBE_MCP_PUBLIC_BASE_URL=http://localhost:8302

# Where uploads, results and job folders live (HTTP only). Keep both on one filesystem, so
# uploaded images are hard-linked into job folders rather than copied.
# SCANSCRIBE_MCP_OUTPUT_DIR=data/documents
# SCANSCRIBE_MCP_WORK_DIR=data/work

# --- OCR ---------------------------------------------------------------------------------------
# SCANSCRIBE_MCP_LANGS=en
# SCANSCRIBE_MCP_DEVICE=gpu:0
